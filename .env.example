# Nivo environment variables
#
# Copy this file to .env.local and fill in your Supabase project values.
# Find them in your Supabase dashboard under Project Settings > API:
#   - Project URL
#   - Publishable key (the client-side key issued by default for new projects)

# Your Supabase project URL (e.g. https://abcd1234.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase publishable key (starts with "sb_publishable_")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
